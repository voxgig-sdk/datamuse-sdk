# BasicPetFlow

main: kit: flow: BasicPetFlow:
{
  entity: "pet",
  kind: "basic",
  name: "BasicPetFlow",
  step: [
    {
      i: {
        ref: "pet_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "pet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pet_ref01",
        srcdatavar: "pet_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pet01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pet_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "pet01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "pet_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPetFlow"
}